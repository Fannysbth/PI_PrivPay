# Copy to .env (never commit .env). Non-secret configuration only.
# Secrets (the three Privacy Service keys, DB passwords, Keycloak client secrets)
# go in secrets/ as Docker secrets; see secrets/README.md. Values below that say
# CHANGE_ME must be replaced locally and must differ between dev and VPS.

# --- Mode (PRD 17) ---
PRIVACY_MODE=proposed            # baseline | proposed (ADR-0003: no static mode)
TZ=UTC

# --- Token lifecycle (PRD 6.1, 8); source of truth is Table 1 ---
GRACE_PERIOD_SECONDS=30
TTL_PAYMENT_PROCESSING=900
TTL_FRAUD_DETECTION=2592000
TTL_NOTIFICATION=900
TTL_NOTIFICATION_REGISTRATION=31536000
TTL_DAILY_RECONCILIATION=86400
TTL_INTERNAL_AUDIT=600
DISCLOSURE_APPROVAL_TTL_SECONDS=600   # v2.4, one-time approval window
PSEUDONYM_KEY_VERSION=1
RETENTION_DAYS=90                # self-chosen research parameter, not a standard

# --- Fraud (PRD 10, 17) ---
FRAUD_AMOUNT_THRESHOLD=1000000
FRAUD_ODD_HOUR_START=22
FRAUD_ODD_HOUR_END=6

# --- Resilience (NFR-12, NFR-21, NFR-08) ---
HTTP_TIMEOUT_MS=3000
HTTP_MAX_RETRY=2
TX_PENDING_TIMEOUT_SECONDS=300
RATE_LIMIT_ENABLED=true          # false only for performance runs (identical in both modes)
RATE_LIMIT_PER_MINUTE=100
ACCESS_TOKEN_TTL_SECONDS=300

# --- Secrets are NOT set here (ADR-0004). Each secret is read from a file whose path
# is given by a <NAME>_FILE variable (same loader as Docker secrets later), e.g.
#   PSEUDONYM_HMAC_SECRET_FILE=./secrets/pseudonym_hmac_secret
#   BLIND_INDEX_SECRET_FILE=./secrets/blind_index_secret
#   FIELD_ENCRYPTION_KEY_FILE=./secrets/field_encryption_key
# Raw secret values in env are rejected at startup.
# Files expected under ./secrets (see secrets/README.md):
#   pseudonym_hmac_secret   -> K_token
#   blind_index_secret      -> K_index
#   field_encryption_key    -> K_field
#   privacy_db_password, transaction_db_password, fraud_db_password,
#   notification_db_password, reconciliation_db_password, keycloak_db_password,
#   keycloak_admin_password, grafana_admin_password
# The three keys MUST differ from each other (FR-30).

# --- Placeholders for non-secret endpoints (service discovery inside Docker networks) ---
PRIVACY_SERVICE_URL=http://privacy-service:3000
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=privpay
LOG_LEVEL=info
