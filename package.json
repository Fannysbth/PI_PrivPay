{
  "name": "privpay",
  "version": "0.0.0",
  "private": true,
  "description": "PrivPay: Privacy-by-Design e-wallet microservices prototype (research artefact)",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -b tsconfig.build.json",
    "test": "jest --config jest.config.cjs",
    "measure:linkage": "node node_modules/jest/bin/jest.js --config jest.measure.config.cjs tests/measure/linkage",
    "measure:exposure": "node node_modules/jest/bin/jest.js --config jest.measure.config.cjs tests/measure/exposure",
    "test:edge": "node node_modules/jest/bin/jest.js --config jest.docker.config.cjs",
    "test:smoke": "tsc -b tsconfig.build.json && node node_modules/jest/bin/jest.js --config jest.smoke.config.cjs",
    "pii-scan": "jest --config jest.config.cjs tests/pii-scan && node --env-file-if-exists=.env.test node_modules/jest/bin/jest.js --config jest.integration.config.cjs services/privacy-service/test/pii-scan services/transaction-service/test/pii-scan services/fraud-service/test/pii-scan services/notification-service/test/flow services/reconciliation-service/test/flow services/transaction-service/test/baseline-repository services/fraud-service/test/baseline-repository services/notification-service/test/baseline-repository services/reconciliation-service/test/baseline-repository services/reconciliation-service/test/chain services/gateway/test/e2e",
    "test:integration": "node --env-file-if-exists=.env.test node_modules/jest/bin/jest.js --config jest.integration.config.cjs",
    "test:security": "node --env-file-if-exists=.env.test node_modules/jest/bin/jest.js --config jest.integration.config.cjs services/privacy-service/test/security",
    "dev:keys": "node scripts/dev/keys.cjs",
    "dev:up": "node --env-file-if-exists=.env.test scripts/dev/up.cjs",
    "dev:down": "node scripts/dev/down.cjs",
    "docker:secrets": "node scripts/docker/make-secrets.cjs && node scripts/docker/tls.cjs",
    "secret-scan:tree": "node scripts/dev/gitleaks-tree.cjs",
    "docker:net-check": "node scripts/docker/net-check.cjs",
    "docker:edge-check": "node scripts/docker/edge-check.cjs",
    "docker:newman": "node scripts/docker/newman.cjs",
    "docker:keycloak-check": "node scripts/docker/keycloak-check.cjs",
    "docker:compose": "node scripts/docker/compose.cjs",
    "db:migrate": "tsc -b tsconfig.build.json && node --env-file-if-exists=.env.test packages/common/dist/bin/db-migrate.js",
    "db:pg16": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db/pg16.ps1",
    "db:test-databases": "tsc -b tsconfig.build.json && node --env-file-if-exists=.env.test packages/common/dist/testing/bin/test-databases.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "yaml": "^2.9.1"
  }
}
