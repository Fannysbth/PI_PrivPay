# Secrets and local env — never commit (SECURITY.md section 3)
.env
.env.*
!.env.example
!.env.test.example
# secrets/* and not secrets/: ignoring the directory itself would make the two exceptions below impossible.
secrets/*
!secrets/README.md
!secrets/.gitkeep

# Local credentials and key material
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
*.kdbx
credentials.json
service-account*.json

# Local state of dev tools (dev-idp customer counter)
.dev-state/

# Dependencies and build output
node_modules/
dist/
build/
coverage/
.nyc_output/
*.tsbuildinfo
.pnpm-store/
.turbo/

# Logs and process ids of `pnpm dev:up`
.dev-run/

# Test and measurement artefacts (keep curated results in docs/ or results/ explicitly)
newman-report*/
k6-output/
*.har
test-results/
playwright-report/

# Secret-scanner reports: unredacted runs can contain the matched values
gitleaks-report*.json

# Logs and dumps — may contain data even if synthetic
*.log
logs/
*.sql.gz
*.dump
*.bak
pgdata/
*.pcap

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# Local tooling
.claude/settings.local.json
.python-version
__pycache__/
*.pyc
.luarocks/

# Local prompt notes
/PROMPT_AWAL.md
/PROMPT_TAMBAHAN.md

# Local artifacts (never pushed to GitHub, per Fanny 2026-11-11)
/artifacts/

# Thesis drafts and local measurement data (never pushed to GitHub, per Fanny 2026-11-11)
/docs/penulisan/
/docs/hasil.zip
/docs/hasil/kinerja/resmi/
/docs/hasil/kinerja/resmii/
